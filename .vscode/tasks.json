{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Octo: Sync Cursor",
      "type": "shell",
      "command": "pwsh",
      "args": ["-File", "${workspaceFolder}/scripts/sync-cursor.ps1"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Octo: Validate harness",
      "type": "shell",
      "command": "bun",
      "args": ["run", "validate", "octo-cluster"],
      "options": { "cwd": "${workspaceFolder}/engine/context-engine" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Octo: Boundary audit",
      "type": "shell",
      "command": "pwsh",
      "args": ["-File", "${workspaceFolder}/scripts/boundary-audit.ps1"],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Octo: Productivity audit",
      "type": "shell",
      "command": "pwsh",
      "args": ["-File", "${workspaceFolder}/scripts/productivity-audit.ps1"],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" }
    }
  ]
}
